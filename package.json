{
  "name": "kynwallet-login",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "\u003e=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit \u0026\u0026 vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "audit:deps": "npm audit --audit-level=high",
    "audit:licenses": "license-checker-rseidelsohn --onlyAllow \"MIT;ISC;BSD-2-Clause;BSD-3-Clause;Apache-2.0;0BSD;OFL-1.1;CC0-1.0;BlueOak-1.0.0\" --excludePackages kynwallet-login@0.1.0",
    "scan:secrets": "secretlint \"**/*\"",
    "verify": "npm run test:controls \u0026\u0026 npm run lint \u0026\u0026 npm run format \u0026\u0026 npm run typecheck \u0026\u0026 npm run test:coverage \u0026\u0026 npm run build \u0026\u0026 npm run audit:deps \u0026\u0026 npm run audit:licenses \u0026\u0026 npm run scan:secrets",
    "test:controls": "node --test scripts/checkSastReport.test.mjs scripts/checkCoverage.test.mjs",
    "check:sast": "node --input-type=module -e \"import {runSastCheck} from \u0027./scripts/checkSastReport.mjs\u0027; console.log(JSON.stringify(runSastCheck(process.argv.slice(1))))\" artifacts/sast.json artifacts/sast-targets.json",
    "check:coverage": "node --input-type=module -e \"import {runCoverageCheck} from \u0027./scripts/checkCoverage.mjs\u0027; console.log(JSON.stringify(runCoverageCheck(process.argv.slice(1))))\" coverage/coverage-summary.json artifacts/reference/coverage/coverage-summary.json artifacts/coverage-inventory.json"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.7",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.4",
    "axe-core": "^4.14.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "license-checker-rseidelsohn": "^5.0.1",
    "prettier": "^3.9.10",
    "secretlint": "^13.0.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
